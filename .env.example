TELEGRAM_BOT_TOKEN=
# One or more targets, comma separated. Group ids are negative.
#   TELEGRAM_CHAT_ID=123456789,-1001234567890
# Find them with: npm run chatid
TELEGRAM_CHAT_ID=
# Optional. The keyless Firecrawl tier now 403s and the DuckDuckGo scrape is
# blocked on CI, so without one of these the web-search net stays off.
BRAVE_API_KEY=
FIRECRAWL_API_KEY=
